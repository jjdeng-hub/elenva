{
  "compilerOptions": {
    "lib": [
      "dom",
      "dom.iterable",
      "esnext"
    ],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/*": [
        "./*"
      ],
      "typebox": [
        "./node_modules/@earendil-works/pi-coding-agent/node_modules/typebox"
      ]
    },
    "target": "ES2017"
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts"
  ],
  "exclude": [
    "node_modules",
    // tools/ 里的探针用「故意报错」当信号（见 tools/pi-surface-check.ts），
    // 还有只在本机的回归夹具 tools/rev/ —— 两者都不能进主检查。
    // 单独检查：tsc -p tools/tsconfig.json
    "tools",
    // 记忆 2.0 收编阶段在本机放的上游只读参考拷贝（不进仓库）。
    // 它的源码已结构性搬进 extensions/elenva-memory/vendor/，由主检查覆盖。
    "_absorb-ref"
  ]
}

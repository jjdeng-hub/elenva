{
  "name": "elenva-web",
  "version": "0.1.0",
  "description": "ELENVA Web —— pi coding agent 的 Web 工作台（个人控制台，自用优先，非 IDE 前端）",
  "license": "MIT",
  "author": "ELENVA",
  "keywords": [
    "pi",
    "pi-package",
    "pi-coding-agent",
    "ai",
    "agent",
    "web-ui",
    "workstation"
  ],
  "engines": {
    "node": ">=22.19.0"
  },
  "bin": {
    "elenva-web": "bin/elenva-web.js"
  },
  "files": [
    "bin",
    ".next",
    "!.next/cache",
    "!.next/dev",
    "!.next/standalone",
    "!.next/**/*.js.map",
    "public",
    "next.config.ts",
    "package.json"
  ],
  "scripts": {
    "dev": "next dev -H 127.0.0.1 -p 30200",
    "dev:lan": "next dev -H 0.0.0.0 -p 30200",
    "build": "next build --webpack",
    "start": "next start -H 127.0.0.1 -p 30200",
    "lint": "eslint .",
    "pack:tarball": "npm run build && npm pack",
    "release": "npm version patch --no-git-tag-version && npm run build && npm publish"
  },
  "dependencies": {
    "@earendil-works/pi-agent-core": "0.86.1",
    "@earendil-works/pi-ai": "0.86.1",
    "@earendil-works/pi-coding-agent": "0.86.1",
    "@earendil-works/pi-tui": "0.86.1",
    "ansi_up": "^6.0.6",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "js-yaml": "^5.2.3",
    "katex": "^0.16.47",
    "lucide-react": "^0.545.0",
    "mammoth": "^1.12.2",
    "next": "16.3.1",
    "proper-lockfile": "4.1.2",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "react-markdown": "^10.1.0",
    "rehype-katex": "^7.0.1",
    "rehype-raw": "^7.0.0",
    "rehype-sanitize": "^6.0.0",
    "remark-frontmatter": "^5.0.0",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0",
    "semver": "7.8.0",
    "tailwind-merge": "^3.3.1",
    "undici": "8.10.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.2.2",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^25",
    "@types/proper-lockfile": "4.1.4",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/semver": "7.8.0",
    "postcss": "^8.5.26",
    "tailwindcss": "^4.2.2",
    "typescript": "^5"
  }
}

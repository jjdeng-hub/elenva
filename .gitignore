# deps & build
node_modules/
.next/
tsconfig.tsbuildinfo

# 打包产物（npm pack 生成，用 npm run pack:tarball 重建）
*.tgz

# 便携包产物（用 tools/build-portable.py 重建）
dist/

# env & local
.env*
*.log
# 服务日志目录（含 logrotate 的 .1/.2 轮转文件）
logs/
# 一键更新的运行状态（启动器 ↔ 网页之间的请求与进度）
.elenva-update.json
.elenva-launcher.json

# ===== 仓库边界：只放 Web UI 代码与工具（规则见 AGENTS.md）=====
